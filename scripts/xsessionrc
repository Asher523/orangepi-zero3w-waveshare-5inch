# 这块屏的 HDMI DDC 时好时坏，驱动又不把模式注册到 connector。
# hdmi-edid-override.service 在开机（X 启动前）就把 EDID override 和 force=on 写好了，
# /etc/X11/xorg.conf.d/20-hdmi-800x480.conf 提供 Modeline。
# 这里只做两件收尾：切到原生时序、让屏幕常亮。
# 放后台执行，不拖慢登录；日志在 ~/.hdmi-mode.log。
(
    export DISPLAY=:0

    # 等输出变成 connected（force 是开机时写的，通常已经就绪）
    for _ in $(seq 1 120); do
        xrandr --query 2>/dev/null | grep -q '^HDMI-1 connected' && break
        sleep 0.5
    done

    xrandr --newmode "800x480_60r" 37.000 800 848 888 1088 480 483 493 560 -HSync -VSync 2>/dev/null
    xrandr --addmode HDMI-1 800x480_60r 2>/dev/null
    xrandr --output HDMI-1 --mode 800x480_60r

    # 常亮：X 默认 10 分钟 DPMS 待机、15 分钟关屏，这块小屏不该自己黑掉
    xset s off
    xset s noblank
    xset -dpms
) >"$HOME/.hdmi-mode.log" 2>&1 &
